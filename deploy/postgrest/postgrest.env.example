# Шаблон /etc/osp-api/postgrest.env (root, 600). Значения в git и в чат не попадают.

# Подключение к базе Яндекса: та же учётка, что у загрузки. Проверка сертификата и имени сервера
# обязательна (sslmode=verify-full). Спецсимволы в пароле — в виде %XX.
#   postgres://УЧЁТКА:ПАРОЛЬ@АДРЕС:6432/БАЗА?sslmode=verify-full&sslrootcert=/etc/ssl/osp/yandex-root.crt&application_name=osp-postgrest
PGRST_DB_URI=

# Внутренний секрет шлюза: тот же, что OSP_PGRST_JWT_SECRET в /etc/osp-api/osp-api.env.
# Создать на сервере:  openssl rand -base64 48
PGRST_JWT_SECRET=

# Дальше — не секреты; менять не нужно.
PGRST_SERVER_HOST=127.0.0.1
PGRST_SERVER_PORT=3001
PGRST_DB_SCHEMAS=public
PGRST_DB_EXTRA_SEARCH_PATH=public
# Каждый запрос начинается с проверки «запрос от шлюза», UTC и таймаута (migration/target/sql/load-single-owner.sql).
PGRST_DB_PRE_REQUEST=osp_private.pre_request
# У учётки базы общий лимит подключений с другими системами: PostgREST берёт не больше шести.
PGRST_DB_POOL=6
PGRST_DB_POOL_ACQUISITION_TIMEOUT=10
# Соединения пула не старше 5 минут. У PostgREST 14 по умолчанию 1800 с: после смены мастера
# старый сокет остаётся на реплике до получаса, простой в 30 с при постоянных запросах не наступает.
# target_session_attrs=read-write сюда не входит: в строке один адрес *.rw, а не список хостов.
# libpq с одним адресом не переходит на другой узел, а пулер на 6432 этот параметр клиента
# как выбор мастера не применяет (это настройка самого Odyssey, и ему нужен список хостов).
PGRST_DB_POOL_MAX_LIFETIME=300
# Перед базой стоит пулер: именованные подготовленные запросы и LISTEN не используем.
PGRST_DB_PREPARED_STATEMENTS=false
PGRST_DB_CHANNEL_ENABLED=false
# Как в Supabase: без диапазона — не больше 1000 строк на запрос.
PGRST_DB_MAX_ROWS=1000
# Роли анонима нет: запрос без токена шлюза PostgREST отклоняет.
PGRST_OPENAPI_MODE=disabled
PGRST_LOG_LEVEL=warn
