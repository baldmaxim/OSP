# Запись портала ОСП в общем nginx сервера для одного имени сайта — __NAME__.
# Собирается из deploy/docker/infra-nginx/site.conf.template (render.sh); вручную не править.
# Один файл на имя; остальные сайты сервера он не затрагивает. Ставится один раз, выкладки портала его
# не меняют. Проверяется в tests/deploy/docker.test.mjs.
#
# Здесь только приём HTTPS и пересылка в контейнер сайта (osp-web:8080 в сети общего nginx).
# Правила самого сайта и /api — в контейнере (deploy/docker/web/site.conf).
#
# Имя osp-web ищется при каждом запросе, а не при запуске nginx: если контейнеры ОСП остановлены, общий
# nginx запускается и перечитывает настройки как обычно, а 502 получает только сайт ОСП.

# В журнал — без строки параметров: ключ выдачи расценок может прийти как ?key=.
log_format osp_noargs___ID__ '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                             '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name __NAME__;
    access_log /var/log/nginx/access.log osp_noargs___ID__;

    # Проверка Let's Encrypt — как у остальных сайтов сервера.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    # /api — только по HTTPS. Без перенаправления: Location вернул бы ?key= обратно, и клиент продолжил
    # бы слать ключ открытым текстом.
    location ~ ^/api(/|$) {
        return 403;
    }
    location / { return 301 https://$host$request_uri; }
}
