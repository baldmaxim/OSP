# Служба своего API портала (server/osp-api). Установка — один раз, от root (docs/DEPLOYMENT.md, «osp-api»):
#   cp /home/danila/projects/OSP/deploy/osp-api.service /etc/systemd/system/osp-api.service
#   systemctl daemon-reload && systemctl enable osp-api
# Секреты — /etc/osp-api/osp-api.env (root, права 600; читает systemd, процесс получает переменные).
# Код — /home/danila/osp-api/current (deploy/api-deploy.sh). Слушает только 127.0.0.1:8787,
# снаружи — через nginx (location ^~ /api/).
[Unit]
Description=OSP API (osp-api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=danila
Group=danila
WorkingDirectory=/home/danila/osp-api/current
EnvironmentFile=/etc/osp-api/osp-api.env
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8787
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
