# Служба своего API портала (server/osp-api). Установка — docs/DEPLOYMENT.md, «Свой API (osp-api)».
# Процесс — от отдельного системного пользователя osp-api: его переменные окружения (секреты) не видны
# процессам danila и других пользователей. Код — /opt/osp-api/current: пишет только выкладка (danila),
# служба читает. Секреты — /etc/osp-api/osp-api.env (root, 600; читает systemd до запуска процесса).
# Слушает только 127.0.0.1:8787, снаружи — через nginx (deploy/nginx/osp.root.sx.conf, location ^~ /api/).
[Unit]
Description=OSP API (osp-api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osp-api
Group=osp-api
WorkingDirectory=/opt/osp-api/current
EnvironmentFile=/etc/osp-api/osp-api.env
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8787
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
