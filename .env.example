# Шаблон окружения. Скопируй файл в .env (он игнорируется git'ом) и заполни значения.
#
# .env используется сразу двумя сторонами:
#   • Vite (фронт) читает только переменные с префиксом VITE_
#   • Supabase Edge Functions (`s3-presign`, `ai-assist`) получают остальные ключи через
#     `supabase functions serve --env-file .env` (локально)
#     и `supabase secrets set --env-file .env` (на проде).

# === Frontend (Vite, читается браузером) ===
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# === Edge Function `s3-presign` (НИКОГДА не попадают в браузер) ===
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=osp
S3_ACCESS_KEY_ID=<заполни-после-ротации-ключа>
S3_SECRET_ACCESS_KEY=<заполни-после-ротации-ключа>

# === Edge Function `ai-assist` (НИКОГДА не попадает в браузер) ===
# Ключ Claude API из console.anthropic.com — ИИ-помощник по протоколу разногласий.
ANTHROPIC_API_KEY=<claude-api-key>
