# Шаблон /etc/osp-api/osp-api.env (на VPS: владелец root, права 600). Значения — те же, что у
# Edge Functions Supabase; в git и в чат значения не попадают. Пустая строка = не задано
# (соответствующий маршрут ответит 500 с понятным текстом, /api/health покажет false).

# Supabase (пока данные там): адрес и публичный anon-ключ — как у фронта (VITE_SUPABASE_*),
# служебный ключ — Project Settings → API Keys (только для /api/rates).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Хранилище документов cloud.ru (s3-presign)
S3_ENDPOINT=
S3_REGION=ru-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ИИ-помощник (ai-assist)
ANTHROPIC_API_KEY=

# Ключи API реестра расценок для смежных отделов, через запятую (rates-api, docs/RATES_API.md). Запись
# «ключ:kp+larix» открывает ключу только перечисленные ресурсы (kp, supply, larix); запись без «:» — kp и supply.
# Ключ — openssl rand -hex 32, свой на каждого потребителя: отзыв — убрать его запись и пересоздать osp-api.
RATES_API_KEYS=

# Что обязано ответить «ok» в /api/ready (иначе выкладка не засчитывается). По умолчанию —
# supabase,s3,anthropic. Сужать только явно: supabase,s3 — если Anthropic недоступен с сервера
# (тогда ospApiAi не включать).
# OSP_API_REQUIRE=supabase,s3,anthropic

# Проверка входа на сервере, без запроса к Supabase на каждое обращение (можно не задавать — тогда как
# раньше). Секрет подписи токенов — в настройках проекта Supabase: JWT Keys → Legacy JWT Secret. По силе равен
# служебному ключу. Кнопку «Migrate JWT secret» не нажимать.
SUPABASE_JWT_SECRET=

# Своё подключение к базе — для статуса учётки и маршрутов данных (можно не задавать).
# OSP_DB_URL — строка подключения целиком (секрет), вида postgres://учётка:пароль@адрес:порт/база;
#   спецсимволы в пароле — в виде %XX; из параметров допустим только ?sslmode=verify-full.
# OSP_DB_CA_FILE — корневой сертификат сервера базы (/etc/ssl/osp/yandex-root.crt, права 644 — он не секрет).
#   Для базы не на этой машине обязателен:
#   без проверки сертификата и имени сервера служба не запустится.
# OSP_DB_POOL_MAX — сколько подключений берёт служба: у учётки базы общий лимит с другими системами;
# OSP_DB_SECOND_LOCK_ROLE — authenticated, пока база в Supabase; в базе Яндекса — пусто.
OSP_DB_URL=
OSP_DB_CA_FILE=
OSP_DB_POOL_MAX=5
OSP_DB_SECOND_LOCK_ROLE=

# Шлюз данных /api/db → PostgREST на этом сервере → база Яндекса (deploy/postgrest). Пока не задано —
# шлюз закрыт, данные портал берёт из Supabase.
# OSP_PGRST_URL — адрес PostgREST: http://127.0.0.1:3001
# OSP_PGRST_JWT_SECRET — внутренний секрет шлюза, тот же, что PGRST_JWT_SECRET в postgrest.env
# OSP_PGRST_DB_ROLE — имя учётки базы (то же, что в строке подключения PostgREST)
# OSP_DB_READONLY_FILE — файл-переключатель барьера записи: есть файл — шлюз только читает
#   (включить: touch /var/lib/osp-api/db-readonly; выключить: rm /var/lib/osp-api/db-readonly).
#   Каталог создаёт служба (StateDirectory); он должен быть ей доступен — иначе служба не запустится.
# OSP_REGISTRY_REFRESH=1 — пересчитывать реестр расценок раз в 10 минут (нужен OSP_DB_URL)
# OSP_SUPPLY_IMPORT=1 — разбирать позиции ВОР для расценки снабжением заранее, раз в 10 минут (src/lib/supplyImport.js):
#   статус «Расценка: N из M» в реестре тендеров на материалы — у всех тендеров. Нужны OSP_DB_URL и хранилище S3_*;
#   только на одном сервере (на прежнем — пусто).
# OSP_KEEP_PRE_TRANSFER_FILES — по умолчанию (пусто) файлы, загруженные до переноса данных, из хранилища
#   не удаляются: на них ссылается прежний портал (osp.root.sx). 0 — когда прежнего портала нет.
OSP_PGRST_URL=
OSP_PGRST_JWT_SECRET=
OSP_PGRST_DB_ROLE=
OSP_DB_READONLY_FILE=/var/lib/osp-api/db-readonly
OSP_REGISTRY_REFRESH=
OSP_SUPPLY_IMPORT=

# Договорные расценки из Larix.CPM (src/lib/larixSync.js): раз в день после 05:00 по Москве.
# LARIX_SYNC=1 — включить (только на одном сервере: на прежнем — пусто). Включено с ошибкой в строках ниже —
#   служба не запускается.
# LARIX_USERNAME / LARIX_PASSWORD — техническая учётка Larix только на чтение ВОР по договорам (секрет).
# LARIX_SYNC_TARGETS — куда писать: db (своя база, нужен OSP_DB_URL), supabase (база прежнего портала, нужен
#   SUPABASE_SERVICE_ROLE_KEY); через запятую. По умолчанию — db. После переноса данных — только db.
# LARIX_BASE_URL — по умолчанию https://cpm.su10.larix.ru (другой адрес не принимается);
# LARIX_APP_CODE — по умолчанию cpm; LARIX_MAX_BYTES — предел всего ответа, по умолчанию 268435456 (256 МБ):
#   ответ разбирается потоком, по одной позиции, поэтому предел защищает от бесконечного ответа, а не память.
LARIX_SYNC=
LARIX_USERNAME=
LARIX_PASSWORD=
LARIX_SYNC_TARGETS=

# Свой вход портала (tender.su10.ru; migration/CUTOVER.md, «Свой вход tender.su10.ru»). Пока AUTH_MODE пуст или
# supabase — вход через Supabase Auth, как раньше.
#   AUTH_MODE            — supabase | both (пилот: свой вход только OSP_AUTH_PILOT_IDS) | own (только свой вход;
#                          Supabase службе не нужен). Меняет scripts/deploy-server.sh auth-mode — без сборки.
#   OSP_AUTH_KEYS        — ключи шифрования паролей «id:base64(32 байта),…», первый — текущий. Секрет: создаёт
#                          deploy-server.sh auth-key-init; копию храните офлайн — без ключа пароли не расшифровать.
#   OSP_AUTH_PILOT_IDS   — идентификаторы пользователей пилота через запятую (режим both).
#   OSP_PUBLIC_ORIGIN    — адрес портала для проверки источника запросов: https://tender.su10.ru
#   OSP_TRUST_PROXY      — peer: адрес клиента из X-Forwarded-For только от своего прокси (на corp задаёт compose.yml).
#   OSP_SESSION_IDLE_DAYS / OSP_SESSION_MAX_DAYS — срок сессии без активности (14) и общий (30), в днях.
AUTH_MODE=
OSP_AUTH_KEYS=
OSP_AUTH_PILOT_IDS=
OSP_PUBLIC_ORIGIN=
OSP_TRUST_PROXY=
OSP_SESSION_IDLE_DAYS=
OSP_SESSION_MAX_DAYS=
