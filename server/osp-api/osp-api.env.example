# Шаблон /etc/osp-api/osp-api.env (на VPS: владелец root, права 600). Значения — те же, что у
# Edge Functions Supabase; в git и в чат значения не попадают. Пустая строка = не задано
# (соответствующий маршрут ответит 500 с понятным текстом, /api/health покажет false).

# Supabase (пока данные там): адрес и публичный anon-ключ — как у фронта (VITE_SUPABASE_*),
# служебный ключ — Project Settings → API Keys (только для /api/rates).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Хранилище документов cloud.ru (s3-presign)
S3_ENDPOINT=
S3_REGION=ru-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ИИ-помощник (ai-assist)
ANTHROPIC_API_KEY=

# Ключи API реестра расценок для смежных отделов, через запятую (rates-api, docs/RATES_API.md). Запись
# «ключ:kp+larix» открывает ключу только перечисленные ресурсы (kp, supply, larix); запись без «:» — kp и supply.
# Ключ — openssl rand -hex 32, свой на каждого потребителя: отзыв — убрать его запись и пересоздать osp-api.
RATES_API_KEYS=

# Что обязано ответить «ok» в /api/ready (иначе выкладка не засчитывается). По умолчанию —
# supabase,s3,anthropic. Сужать только явно: supabase,s3 — если Anthropic недоступен с сервера
# (тогда ospApiAi не включать).
# OSP_API_REQUIRE=supabase,s3,anthropic

# Проверка входа на сервере, без запроса к Supabase на каждое обращение (можно не задавать — тогда как
# раньше). Секрет подписи токенов — в настройках проекта Supabase: JWT Keys → Legacy JWT Secret. По силе равен
# служебному ключу. Кнопку «Migrate JWT secret» не нажимать.
SUPABASE_JWT_SECRET=

# Своё подключение к базе — для статуса учётки и маршрутов данных (можно не задавать).
# OSP_DB_URL — строка подключения целиком (секрет), вида postgres://учётка:пароль@адрес:порт/база;
#   спецсимволы в пароле — в виде %XX; из параметров допустим только ?sslmode=verify-full.
# OSP_DB_CA_FILE — корневой сертификат сервера базы (/etc/ssl/osp/yandex-root.crt, права 644 — он не секрет).
#   Для базы не на этой машине обязателен:
#   без проверки сертификата и имени сервера служба не запустится.
# OSP_DB_POOL_MAX — сколько подключений берёт служба: у учётки базы общий лимит с другими системами;
# OSP_DB_SECOND_LOCK_ROLE — authenticated, пока база в Supabase; в базе Яндекса — пусто.
OSP_DB_URL=
OSP_DB_CA_FILE=
OSP_DB_POOL_MAX=5
OSP_DB_SECOND_LOCK_ROLE=

# Шлюз данных /api/db → PostgREST на этом сервере → база Яндекса (deploy/postgrest). Пока не задано —
# шлюз закрыт, данные портал берёт из Supabase.
# OSP_PGRST_URL — адрес PostgREST: http://127.0.0.1:3001
# OSP_PGRST_JWT_SECRET — внутренний секрет шлюза, тот же, что PGRST_JWT_SECRET в postgrest.env
# OSP_PGRST_DB_ROLE — имя учётки базы (то же, что в строке подключения PostgREST)
# OSP_DB_READONLY_FILE — файл-переключатель барьера записи: есть файл — шлюз только читает
#   (включить: touch /var/lib/osp-api/db-readonly; выключить: rm /var/lib/osp-api/db-readonly).
#   Каталог создаёт служба (StateDirectory); он должен быть ей доступен — иначе служба не запустится.
# OSP_REGISTRY_REFRESH=1 — пересчитывать реестр расценок: такт раз в 10 минут, пересчёт — если источники менялись (нужен OSP_DB_URL)
# OSP_SUPPLY_IMPORT=1 — разбирать позиции ВОР для расценки снабжением заранее, раз в 10 минут (src/lib/supplyImport.js):
#   статус «Расценка: N из M» в реестре тендеров на материалы — у всех тендеров. Нужны OSP_DB_URL и хранилище S3_*;
#   только на одном сервере (на прежнем — пусто).
# OSP_KEEP_PRE_TRANSFER_FILES — по умолчанию (пусто) файлы, загруженные до переноса данных, из хранилища
#   не удаляются: на них ссылается прежний портал (osp.root.sx). 0 — когда прежнего портала нет.
OSP_PGRST_URL=
OSP_PGRST_JWT_SECRET=
OSP_PGRST_DB_ROLE=
OSP_DB_READONLY_FILE=/var/lib/osp-api/db-readonly
OSP_REGISTRY_REFRESH=
OSP_SUPPLY_IMPORT=

# Договорные расценки из Larix.CPM (src/lib/larixSync.js): раз в день после 05:00 по Москве.
# LARIX_SYNC=1 — включить (только на одном сервере: на прежнем — пусто). Включено с ошибкой в строках ниже —
#   служба не запускается.
# LARIX_USERNAME / LARIX_PASSWORD — техническая учётка Larix только на чтение ВОР по договорам (секрет).
# LARIX_SYNC_TARGETS — куда писать: db (своя база, нужен OSP_DB_URL), supabase (база прежнего портала, нужен
#   SUPABASE_SERVICE_ROLE_KEY); через запятую. По умолчанию — db. После переноса данных — только db.
# LARIX_BASE_URL — по умолчанию https://cpm.su10.larix.ru (другой адрес не принимается);
# LARIX_APP_CODE — по умолчанию cpm; LARIX_MAX_BYTES — предел всего ответа, по умолчанию 268435456 (256 МБ):
#   ответ разбирается потоком, по одной позиции, поэтому предел защищает от бесконечного ответа, а не память.
LARIX_SYNC=
LARIX_USERNAME=
LARIX_PASSWORD=
LARIX_SYNC_TARGETS=

# Сверка договоров с папками Signal (src/lib/signalSync.js, signalJobs.js, routes/signal.js, раздел «Signal» в «Администрировании»).
# Только чтение: в Signal служба ничего не пишет. Нужна своя база (OSP_DB_URL) с миграцией 20270228_signal_integration.
# SIGNAL_SYNC=1 — включить (только на одном сервере: на прежнем — пусто). Ошибка в строках SIGNAL_* ниже службу НЕ роняет:
#   сверка выключается с причиной config_invalid, в журнале службы — имена неверных переменных (значений нет), во вкладке
#   «Signal» у администратора — та же причина, /api/health отдаёт signal: "config_invalid"; остальной портал работает. Без
#   схемы в базе служба тоже работает как раньше: маршруты /api/signal/* отвечают «выключено».
# SIGNAL_CLIENT_ID / SIGNAL_CLIENT_SECRET — ключ интеграции Signal (секрет); задайте оба или ни одного. Без них очередь
#   сверки по готовому снимку работает, обход Signal и добавление корней — нет.
# SIGNAL_BASE_URL — по умолчанию https://api.sgnl.pro; SIGNAL_HOSTS — точные хосты через запятую (по умолчанию хост
#   SIGNAL_BASE_URL); SIGNAL_SCOPES — права ключа (по умолчанию project:list docs:folder:read docs:item:list).
# SIGNAL_URL_FORMATS — шаблоны ссылок Signal на папку или файл через «;», например
#   https://хост/путь/{projectId}/…/{folderId} (или {itemId}); пусто — любая ссылка договора «формат не поддержан».
# SIGNAL_UI_FOLDER_URL — шаблон адреса папки для «Подтвердить» (с {projectId} и {folderId}); пусто — подтверждение недоступно.
# SIGNAL_UI_FILE_URL — шаблон адреса файла (с {projectId} и {itemId}); пусто — файлы в окне сверки без ссылок.
#   Оба шаблона обязаны разбираться списком SIGNAL_URL_FORMATS (добавьте тот же шаблон в него): иначе ссылка, подтверждённая
#   в портале, не распознается сверкой — config_invalid.
# SIGNAL_DAY_MODE — дневной обход: full (по умолчанию, все папки) или known (папки со связью и предложением + новые).
# SIGNAL_TICK_MS (300000) — как часто спрашивать базу «пора ли обходить»; SIGNAL_JOBS_TICK_MS (15000) — такт очереди сверки;
# SIGNAL_TIMEOUT_MS (30000), SIGNAL_MAX_BYTES (16777216) — предел времени и размера ответа Signal;
# SIGNAL_RUN_BUDGET_MS (3000000) — предел времени одного обхода; SIGNAL_ROOT_BUDGET_MS (2400000) — предел одного корня
#   (не больше SIGNAL_RUN_BUDGET_MS, иначе config_invalid): корень сверх предела — «сбой корня», остальные корни обходятся.
# SIGNAL_PAGE_END — когда страница элементов считается последней (TODO(G1), протокол не подтверждён): empty (по умолчанию) —
#   только пустая; short — и короче запрошенной (меньше запросов). Прочее значение — empty.
# SIGNAL_RETRY_AFTER_MIN_MS (1000), SIGNAL_RETRY_AFTER_MAX_MS (120000) — границы ожидания по Retry-After при лимите запросов
#   Signal (минимум не даёт «Retry-After: 0» повторять запросы подряд); минимум не больше максимума.
# SIGNAL_DELETED_LOOKUP_LIMIT (200) — запросов удалённых файлов (deleted=true) за прогон для файлов со ссылкой договоров;
#   0 — адресный запрос выключен (удалённый файл тогда виден как «не виден в Signal» после двух ночей).
# SIGNAL_STALE_WORK_HOURS (3), SIGNAL_STALE_OFF_HOURS (36) — через сколько часов без обновления данные Signal считаются
#   устаревшими (полоса «Данные Signal обновлялись …» и оповещение администратору): в рабочее время (пн–пт 08:00–20:00 по
#   Москве) и вне его.
SIGNAL_SYNC=
SIGNAL_CLIENT_ID=
SIGNAL_CLIENT_SECRET=
SIGNAL_BASE_URL=
SIGNAL_HOSTS=
SIGNAL_SCOPES=
SIGNAL_URL_FORMATS=
SIGNAL_UI_FOLDER_URL=
SIGNAL_UI_FILE_URL=
SIGNAL_DAY_MODE=
SIGNAL_TICK_MS=
SIGNAL_JOBS_TICK_MS=
SIGNAL_TIMEOUT_MS=
SIGNAL_MAX_BYTES=
SIGNAL_RUN_BUDGET_MS=
SIGNAL_ROOT_BUDGET_MS=
SIGNAL_PAGE_END=
SIGNAL_RETRY_AFTER_MIN_MS=
SIGNAL_RETRY_AFTER_MAX_MS=
SIGNAL_DELETED_LOOKUP_LIMIT=
SIGNAL_STALE_WORK_HOURS=
SIGNAL_STALE_OFF_HOURS=

# Свой вход портала (tender.su10.ru; migration/CUTOVER.md, «Свой вход tender.su10.ru»). Пока AUTH_MODE пуст или
# supabase — вход через Supabase Auth, как раньше.
#   AUTH_MODE            — supabase | both (пилот: свой вход только OSP_AUTH_PILOT_IDS) | keycloak (вход через СУ-10, ниже) | own (только свой вход;
#                          Supabase службе не нужен). Меняет scripts/deploy-server.sh auth-mode — без сборки.
#   OSP_AUTH_KEYS        — ключи шифрования паролей «id:base64(32 байта),…», первый — текущий. Секрет: создаёт
#                          deploy-server.sh auth-key-init; копию храните офлайн — без ключа пароли не расшифровать.
#   OSP_AUTH_PILOT_IDS   — идентификаторы пользователей пилота через запятую (режим both).
#   OSP_PUBLIC_ORIGIN    — адрес портала для проверки источника запросов: https://tender.su10.ru
#   OSP_TRUST_PROXY      — peer: адрес клиента из X-Forwarded-For только от своего прокси (на corp задаёт compose.yml).
#   OSP_SESSION_IDLE_DAYS / OSP_SESSION_MAX_DAYS — срок сессии без активности (14) и общий (30), в днях.
AUTH_MODE=
OSP_AUTH_KEYS=
OSP_AUTH_PILOT_IDS=
OSP_PUBLIC_ORIGIN=
OSP_TRUST_PROXY=
OSP_SESSION_IDLE_DAYS=
OSP_SESSION_MAX_DAYS=

# Регистрация подрядчика на сайте (src/lib/auth/signup.js). Закрыта, пока не заданы AUTH_MODE=own и OSP_CONTRACTOR_SIGNUP=1.
# Сначала — миграции 20261203 и 20261204.
#   OSP_CONTRACTOR_SIGNUP_MODE — manual (по умолчанию): заявки решает администратор, почта не нужна, остальное ниже не задавать;
#                             email: подрядчик регистрируется сам, по письму. Нужны OSP_SMTP_URL и OSP_MAIL_FROM.
#   OSP_SMTP_URL            — секрет: smtps://логин:пароль@сервер:465 или smtp://логин:пароль@сервер:587 (STARTTLS обязателен).
#                             Поставщик любой с SMTP: Yandex Cloud Postbox, Amazon SES. У домена отправителя — SPF, DKIM, DMARC.
#   OSP_MAIL_FROM           — от кого: «Тендерная площадка СУ-10 <no-reply@su10.ru>»
#   OSP_MAIL_REPLY_TO       — куда отвечать; по умолчанию tender.osp@su10.ru
#   OSP_SIGNUP_NOTIFY_EMAIL — куда сообщать, что заявка ждёт решения администратора; пусто — не сообщать
#   OSP_SIGNUP_DAILY_CAP    — заявок за сутки на весь портал; сверх — регистрация закрывается до следующих суток; по умолчанию 50 (manual), 200 (email)
OSP_CONTRACTOR_SIGNUP=
OSP_CONTRACTOR_SIGNUP_MODE=
OSP_SMTP_URL=
OSP_MAIL_FROM=
OSP_MAIL_REPLY_TO=
OSP_SIGNUP_NOTIFY_EMAIL=
OSP_SIGNUP_DAILY_CAP=

# Вход через Keycloak su10 (AUTH_MODE=keycloak; migration/CUTOVER.md, «Вход через Keycloak su10»). Значения проверяются, когда
# заданы, обязательны — только в режиме keycloak; переключение в own их не стирает. Сначала — миграция 20270112 и выпуск 0
# (OSP_WEB_TOKEN). Переключение — bash scripts/deploy-server.sh auth-mode keycloak | own.
#   OIDC_ISSUER                    — https://auth.su10.ru/realms/su10 (строго как в discovery: иначе служба не стартует)
#   OIDC_CLIENT_ID                 — osp
#   OIDC_CLIENT_SECRET             — секрет: из консоли Keycloak (Clients → osp → Credentials), кладёт владелец контура
#   OIDC_REDIRECT_URI              — ровно <OSP_PUBLIC_ORIGIN>/api/auth/oidc/callback
#   OIDC_POST_LOGOUT_REDIRECT_URI  — <OSP_PUBLIC_ORIGIN>/login
#   OIDC_SCOPES                    — openid email profile (по умолчанию)
#   OIDC_LINK_BY_EMAIL             — false; true — только на окно переключения и только после письменного подтверждения команды
#                                    auth, что почту в Keycloak меняет администратор (строка в migration/CUTOVER.md)
#   OIDC_RECHECK_SEC               — перепроверка сессии в Keycloak, по умолчанию 300
#   OIDC_ACTIVITY_WINDOW_SEC       — простой вкладки, после которого фоновые запросы встают (OSP_IDLE), по умолчанию 1800
#   OIDC_MAX_OFFLINE_SEC           — сколько работать без ответа Keycloak, по умолчанию 3600
#   KC_ADMIN_CLIENT_ID             — osp-access-sync (сверка группы доступа; вместе с секретом или никак)
#   KC_ADMIN_CLIENT_SECRET         — секрет: из консоли Keycloak (Clients → osp-access-sync → Credentials)
#   KC_ACCESS_GROUP                — osp-access (по умолчанию)
#   KC_ACCESS_SYNC_INTERVAL_SEC    — сверка группы, по умолчанию 300
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=
OIDC_LINK_BY_EMAIL=
OIDC_RECHECK_SEC=
OIDC_ACTIVITY_WINDOW_SEC=
OIDC_MAX_OFFLINE_SEC=
KC_ADMIN_CLIENT_ID=
KC_ADMIN_CLIENT_SECRET=
KC_ACCESS_GROUP=
KC_ACCESS_SYNC_INTERVAL_SEC=

# Замок сайта (сервер corp): osp-api в общей сети сервера отвечает только запросам с жетоном osp-web. OSP_WEB_GATE задаёт
# compose.yml; OSP_WEB_TOKEN — секрет, тот же в secrets/osp-web.env (bash scripts/deploy-server.sh web-token-init).
OSP_WEB_TOKEN=
